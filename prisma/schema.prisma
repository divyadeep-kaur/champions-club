generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Staff {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  role          String
  monthlySalary Int            @default(0)
  code          String?        @unique
  jobTitle      String         @default("")
  department    String         @default("management")
  phone         String?
  joinedAt      DateTime       @default(now())
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  shifts        Shift[]
  leaves        LeaveRequest[] @relation("LeaveStaff")
  decisions     LeaveRequest[] @relation("LeaveDecider")
  payslips      Payslip[]
  invoices      StaffInvoice[]
  queries       StaffQuery[]   @relation("QueryStaff")
  replies       StaffQuery[]   @relation("QueryReplier")
  memberChanges MembershipChange[]
  planAudits    PlanAudit[]
}

model Payslip {
  id          Int      @id @default(autoincrement())
  staffId     Int
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month       String
  gross       Int
  basic       Int
  hra         Int
  allowance   Int
  pf          Int
  esi         Int
  pt          Int
  advance     Int      @default(0)
  net         Int
  employerPf  Int
  employerEsi Int
  leaveDays   Int      @default(0)
  expenseId   Int?
  createdAt   DateTime @default(now())

  @@unique([staffId, month])
}

model StaffInvoice {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  staffId     Int
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind        String
  month       String?
  payslipId   Int?     @unique
  queryId     Int?     @unique
  expenseId   Int?
  description String
  amount      Int
  issuedAt    DateTime @default(now())

  @@index([staffId])
}

model StaffQuery {
  id             Int       @id @default(autoincrement())
  staffId        Int
  staff          Staff     @relation("QueryStaff", fields: [staffId], references: [id], onDelete: Cascade)
  topic          String
  subject        String
  message        String
  amount         Int?
  status         String    @default("open")
  reply          String?
  repliedById    Int?
  repliedBy      Staff?    @relation("QueryReplier", fields: [repliedById], references: [id])
  repliedAt      DateTime?
  expenseId      Int?
  recoveredMonth String?
  createdAt      DateTime  @default(now())

  @@index([status])
}

model Plan {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  monthlyFee   Int
  courtRate    Int
  shopDiscount Int
  barDiscount  Int
  durationDays Int      @default(30)
  description  String
  active       Boolean  @default(true)
  members      Member[]
  changesFrom  MembershipChange[] @relation("ChangeFrom")
  changesTo    MembershipChange[] @relation("ChangeTo")
  audits       PlanAudit[]
}

model Member {
  id        Int            @id @default(autoincrement())
  code      String         @unique
  name      String
  phone     String         @unique
  email     String?
  birthDate DateTime?
  planId    Int
  plan      Plan           @relation(fields: [planId], references: [id])
  startDate DateTime
  endDate   DateTime
  notes     String?
  photo         String?
  suspendedAt   DateTime?
  suspendReason String?
  createdAt DateTime       @default(now())
  bookings  Booking[]
  players   SocialPlayer[]
  orders    Order[]
  tabs      Tab[]
  leads     Lead[]
  changes   MembershipChange[]
}

model Court {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  sport      String
  walkInRate Int
  bookings   Booking[]
}

model Booking {
  id         Int            @id @default(autoincrement())
  courtId    Int
  court      Court          @relation(fields: [courtId], references: [id])
  memberId   Int?
  member     Member?        @relation(fields: [memberId], references: [id])
  guestName  String?
  guestPhone String?
  start      DateTime
  end        DateTime
  type       String         @default("regular")
  capacity   Int            @default(1)
  price      Int
  status     String         @default("booked")
  createdAt  DateTime       @default(now())
  players    SocialPlayer[]
  leads      Lead[]

  @@index([courtId, start])
}

model SocialPlayer {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  memberId  Int?
  member    Member?  @relation(fields: [memberId], references: [id])
  name      String
  phone     String?
  status    String   @default("confirmed")
  price     Int      @default(0)
  createdAt DateTime @default(now())
}

model Product {
  id         Int         @id @default(autoincrement())
  sku        String      @unique
  name       String
  category   String
  price      Int
  stock      Int
  lowStockAt Int         @default(5)
  photo      String?
  createdAt  DateTime    @default(now())
  items      OrderItem[]
}

model Order {
  id            Int         @id @default(autoincrement())
  memberId      Int?
  member        Member?     @relation(fields: [memberId], references: [id])
  customerName  String
  customerPhone String?
  channel       String
  fulfilment    String
  address       String?
  clubSpot      String?
  deliveryPhone String?
  pincode       String?
  shipping      Int         @default(0)
  status        String      @default("pending")
  subtotal      Int
  discount      Int         @default(0)
  total         Int
  paymentMethod String?
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Int
}

model MenuItem {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  category  String
  price     Int
  active    Boolean   @default(true)
  photo     String?
  createdAt DateTime  @default(now())
  items     TabItem[]
}

model BarTable {
  id    Int    @id @default(autoincrement())
  label String @unique
  tabs  Tab[]
}

model Shift {
  id      Int       @id @default(autoincrement())
  staffId Int
  staff   Staff     @relation(fields: [staffId], references: [id])
  start   DateTime  @default(now())
  end     DateTime?
  tabs    Tab[]
}

model Tab {
  id            Int       @id @default(autoincrement())
  tableId       Int?
  table         BarTable? @relation(fields: [tableId], references: [id])
  memberId      Int?
  member        Member?   @relation(fields: [memberId], references: [id])
  guestName     String?
  shiftId       Int?
  shift         Shift?    @relation(fields: [shiftId], references: [id])
  status        String    @default("open")
  subtotal      Int       @default(0)
  discount      Int       @default(0)
  total         Int       @default(0)
  paymentMethod String?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  items         TabItem[]
}

model TabItem {
  id         Int       @id @default(autoincrement())
  tabId      Int
  tab        Tab       @relation(fields: [tabId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id])
  qty        Int
  unitPrice  Int
  status     String    @default("new")
  readyAt    DateTime?
  createdAt  DateTime  @default(now())
}

model Lead {
  id          Int            @id @default(autoincrement())
  name        String
  phone       String
  email       String?
  interest    String
  message     String?
  preferredAt DateTime?
  status      String         @default("new")
  quoteAmount Int?
  plan        String?
  notes       String?
  memberId    Int?
  member      Member?        @relation(fields: [memberId], references: [id])
  bookingId   Int?
  booking     Booking?       @relation(fields: [bookingId], references: [id])
  createdAt   DateTime       @default(now())
  activities  LeadActivity[]
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String
  text      String
  staffName String?
  createdAt DateTime @default(now())
}

model Payment {
  id        Int      @id @default(autoincrement())
  source    String
  refId     Int?
  amount    Int
  method    String
  note      String?
  createdAt DateTime @default(now())
  membershipChange MembershipChange?

  @@index([createdAt])
}

model Expense {
  id          Int       @id @default(autoincrement())
  category    String
  description String
  vendor      String?
  amount      Int
  dueDate     DateTime
  paidAt      DateTime?
  method      String?
  createdAt   DateTime  @default(now())

  @@index([dueDate])
}

model LeaveRequest {
  id          Int       @id @default(autoincrement())
  staffId     Int
  staff       Staff     @relation("LeaveStaff", fields: [staffId], references: [id])
  from        DateTime
  to          DateTime
  reason      String
  status      String    @default("pending")
  decidedById Int?
  decidedBy   Staff?    @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Invoice {
  id              Int           @id @default(autoincrement())
  number          String        @unique
  customerName    String
  customerGstin   String?
  customerAddress String?
  memberId        Int?
  status          String        @default("issued")
  issuedAt        DateTime      @default(now())
  dueAt           DateTime
  paidAt          DateTime?
  notes           String?
  lines           InvoiceLine[]
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Int
  unitPrice   Int
  gstRate     Int
}

// One row per membership event: joining, renewal, plan change, extension,
// suspension or reactivation. Rows are only ever added, never edited away,
// so the full history survives any number of changes.
model MembershipChange {
  id            Int       @id @default(autoincrement())
  memberId      Int
  member        Member    @relation(fields: [memberId], references: [id])
  kind          String
  fromPlanId    Int?
  fromPlan      Plan?     @relation("ChangeFrom", fields: [fromPlanId], references: [id])
  toPlanId      Int?
  toPlan        Plan?     @relation("ChangeTo", fields: [toPlanId], references: [id])
  prevStart     DateTime?
  prevEnd       DateTime?
  newStart      DateTime?
  newEnd        DateTime?
  effectiveDate DateTime
  policy        String?
  amount        Int       @default(0)
  paymentStatus String    @default("none")
  paymentId     Int?      @unique
  payment       Payment?  @relation(fields: [paymentId], references: [id])
  method        String?
  reason        String
  staffId       Int
  staff         Staff     @relation(fields: [staffId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([memberId, createdAt])
  @@index([paymentStatus])
}

// A record of every edit to a plan's price or benefits.
model PlanAudit {
  id        Int      @id @default(autoincrement())
  planId    Int
  plan      Plan     @relation(fields: [planId], references: [id])
  changes   String
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

// Club-wide settings the owner can change, such as the default mid-cycle plan change policy.
model ClubSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
